# Copie para .env e preencha. Nunca envie o .env para o Git, e-mail ou grupo.
# A API valida estas variáveis ao iniciar e não sobe se algo estiver errado.
NODE_ENV=development
PORT=3000

# Banco de dados (local: localhost; na nuvem: endpoint do AWS RDS). Em produção, todas são obrigatórias.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mantiqueira_db
# Banco usado por "npm test" (é apagado e recriado a cada execução; precisa terminar com _test)
DB_NAME_TEST=mantiqueira_test
# Conexões simultâneas no pool (opcional, padrão 10)
# DB_POOL_MAX=10

# Segredos: use valores longos e aleatórios, diferentes em cada ambiente.
# JWT_SECRET precisa ter pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
# Duração do token de login: número + s, m, h ou d (opcional, padrão 8h)
# JWT_EXPIRES_IN=8h
# A equipe (funcionário/gerente/admin) é criada pelo admin em POST /api/v1/admin/usuarios.
# A antiga CHAVE_CADASTRO_GESTOR não é mais usada e pode ser removida do seu .env.

# Limites por IP (opcionais): requisições por minuto em /api/v1, falhas de login a cada 15 min e cadastros por hora
# LIMITE_GLOBAL=600
# LOGIN_LIMITE=10
# CADASTRO_LIMITE=10

# Endereços do front-end permitidos no CORS, separados por vírgula (opcional). São somados aos padrões
# de desenvolvimento: http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173, :3000 e :3001.
# CORS_ORIGINS=https://seu-front.exemplo.com
# Defina como 1 se a API ficar atrás de proxy (ex.: Nginx na EC2)
# TRUST_PROXY=1

# Jobs agendados (carga do catálogo à meia-noite e estoque a cada 30 min). Padrão: ligados, exceto nos testes.
# JOBS_ATIVOS=true
# Pasta com entrada/, processados/ e rejeitados/ usada pelos jobs (padrão: ./importacao)
# IMPORTACAO_DIR=/var/mantiqueira/importacao

# Logs: debug | info | warn | error | silent. Formato: texto (padrão em dev) ou json (padrão em produção)
# LOG_LEVEL=info
# LOG_FORMAT=json
# Tamanho máximo do corpo JSON (opcional, padrão 200kb)
# JSON_LIMIT=200kb
